DB_URL=jdbc:postgresql://localhost:5432/deen_walletdb
DB_USERNAME=deen_wallet
DB_PASSWORD=change-me
JWT_SECRET=replace-with-at-least-64-random-characters
MAIL_HOST=smtp.zoho.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@example.com
MAIL_PASSWORD=your-mail-app-password
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-strong-password
ADMIN_PHONE=+232XXXXXXXX
# Leave unset/false. Only set to true for a single deliberate restart if you
# genuinely need to recover a locked-out/disabled super-admin account outside
# the normal email-OTP recovery flow (/api/admin/auth/recovery/*). Set it back
# to false immediately after. Leaving this "true" permanently recreates a
# skeleton-key vulnerability that was fixed in this codebase.
ADMIN_FORCE_RESET=false
MONIME_ACCESS_TOKEN=
MONIME_SPACE_ID=
MONIME_WEBHOOK_SECRET=
MONIME_DEFAULT_FINANCIAL_ACCOUNT_ID=
SUPPORT_WHATSAPP=+23280613600

# Firebase Admin SDK (push notifications). Download from Firebase Console ->
# Project Settings -> Service Accounts -> Generate new private key. Put the
# downloaded JSON file OUTSIDE the repo (like .env) and point this at it.
# Leave blank to run with push notifications disabled.
FIREBASE_SERVICE_ACCOUNT_PATH=

SERVER_PORT=8082
