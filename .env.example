# Production environment template.
# NEVER put real passwords, API tokens, webhook secrets, JWT secrets, or
# Firebase private keys in this file or commit them to Git.

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
ADMIN_PHONE=+232XXXXXXXX
ADMIN_FORCE_RESET=false

DB_URL=jdbc:postgresql://127.0.0.1:5432/deenwallet
DB_USERNAME=deenwallet
DB_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_DATABASE_PASSWORD

SERVER_PORT=8082

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME
MAIL_PASSWORD=CHANGE_ME
MAIL_FROM_EMAIL=no-reply@example.com

JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_AT_LEAST_64_CHARACTERS

FIREBASE_SERVICE_ACCOUNT_PATH=/secure/path/firebase-service-account.json
CORS_ALLOWED_ORIGINS=https://deenwallapp.com,https://api.deenwallapp.com

MONIME_ACCESS_TOKEN=CHANGE_ME
MONIME_SPACE_ID=spc-CHANGE_ME
MONIME_WEBHOOK_SECRET=CHANGE_ME_TO_A_RANDOM_WEBHOOK_SECRET
MONIME_DEFAULT_FINANCIAL_ACCOUNT_ID=fac-CHANGE_ME

SUPPORT_TOKEN=CHANGE_ME
RATE_LIMIT_TRUST_FORWARDED_FOR=true
